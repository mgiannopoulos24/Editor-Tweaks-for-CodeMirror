{
  "core": null,
  "phpVersion": "8.3",
  "themes": ["WordPress/twentytwentyfive"],
  "plugins" : [
    "https://downloads.wordpress.org/plugin/plugin-check.zip"
  ],
  "mappings": {
    "wp-content/plugins/editor-tweaks-for-codemirror": "."
  },
  "port": 8888,
  "testsEnvironment": false,
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": false,
    "SCRIPT_DEBUG": true,
    "WP_ENVIRONMENT_TYPE": "local",
    "DISALLOW_FILE_EDIT": false,
    "WP_DEVELOPMENT_MODE": "plugin"
  },
  "lifecycleScripts": {
    "afterStart": "wp-env run cli wp plugin activate editor-tweaks-for-codemirror"
  }
}